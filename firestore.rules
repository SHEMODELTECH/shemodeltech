rules_version = '2';

// =====================================================================
// She Model Tech, Firestore Security Rules (v2, she-model-tech project)
// =====================================================================
// Posture:
// - Signed-in only. No anonymous/public access.
// - The platform is FREE: no plan tiers, no quotas.
// - BADGES AND CERTIFICATES ARE THE PRODUCT. They can only be written by
// the owner of the project they came from, or by an admin. A member can
// NEVER award themselves a badge. (In v1, `allow write: if isSignedIn()`
// meant anyone could, that is fixed here.)
// - Cohort leads are SELECTED by reviewers after interview. There is no
// self-claim path: applying writes to `lead_applications`, and only a
// reviewer can set a project's owner.
// - 'admin' = full moderation + delete powers.
// 'editor' = reviewer: runs cohorts, reviews lead applications, approves
// project submissions. Deliberately NO delete powers.
// =====================================================================

service cloud.firestore {
 match /databases/{database}/documents {

 function isSignedIn() { return request.auth != null; }
 function myUid() { return request.auth.uid; }
 function myEmail() { return request.auth.token.email; }
 function myUserDoc() {
 return get(/databases/$(database)/documents/users/$(myUid())).data;
 }
 function hasProfile() {
 return isSignedIn()
 && exists(/databases/$(database)/documents/users/$(myUid()));
 }
 function isAdmin() {
 return hasProfile() && myUserDoc().role == 'admin';
 }
 // Enrolled in a Learning course (course_enrollments/{course}/learners/{uid}),
 // or a mentor or staff member, who can take part in any course's discussion.
 function canJoinCourse(courseKey) {
 return isSignedIn() && (
 exists(/databases/$(database)/documents/course_enrollments/$(courseKey)/learners/$(request.auth.uid))
 || isReviewer() || isTeacherUser());
 }
 // Premium, granted by an admin (or payment activation later).
 // Company tiers (Supporter < Partner < Champion), set only by admins.
 // A tier counts while companyTierUntil is empty or still in the future.
 function tierRank() {
 let t = hasProfile() ? myUserDoc().get('companyTier', '') : '';
 let until = hasProfile() ? myUserDoc().get('companyTierUntil', null) : null;
 let active = until == null || until > request.time;
 return !active ? 0 : t == 'champion' ? 3 : t == 'partner' ? 3 : t == 'supporter' ? 1 : 0;
 }
 // Launch switches (Admin → Launch settings).
 function featureOn(name) {
 return exists(/databases/$(database)/documents/app_settings/features)
 && get(/databases/$(database)/documents/app_settings/features).data.get(name, false) == true;
 }
 // Free companies (Company tiers on, no tier, not staff): limited messaging.
 function limitedCompany() {
 return hasProfile() && myUserDoc().get('isCompany', false) == true
 && !(myUserDoc().get('role', 'member') in ['admin', 'editor'])
 && featureOn('companyTiers') && tierRank() == 0;
 }
 // This month (UTC), e.g. "2026-10".
 function monthKey() {
 let m = request.time.month();
 return string(request.time.year()) + '-' + (m < 10 ? '0' + string(m) : string(m));
 }
 function otherParticipant(p) {
 return p[0] == myUid() ? p[1] : p[0];
 }
 function isStaffUid(uid) {
 return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'member') in ['admin', 'editor'];
 }
 // Kept for older rules: "premium" now means any company tier.
 function isPremiumUser() {
 return tierRank() >= 1;
 }
 function isTeacherUser() {
 return hasProfile() && myUserDoc().get('isTeacher', false) == true;
 }
 function isReviewer() {
 return hasProfile()
 && (myUserDoc().role == 'admin' || myUserDoc().role == 'editor');
 }
 // ---------------------------------------------------------------
 // Confirmed email (anti-spam). Posting content others see, contacting
 // people, and applying need a confirmed email address. Exempt: members
 // whose profile was created before 2026-10-09 06:25 UTC (when this rule went live)
 // (or has no createdAt;
 // grandfathered), and staff (admins and editors). Google sign-ins are
 // already confirmed. Reading, learning, and editing your own profile
 // never need it.
 // Cost: the token check is free. Only when the token says "not
 // confirmed" do we read the member's own users doc (one billed read,
 // shared with any other get() of that doc in the same request). Keep
 // isVerified() LAST in a condition so it runs only for gated writes
 // that pass every other check.
 // ---------------------------------------------------------------
 function isGrandfathered() {
 let c = myUserDoc().get('createdAt', null);
 return c == null || !(c is timestamp) || c < timestamp.value(1791527100000);
 }
 function isVerified() {
 return isSignedIn() && (
 request.auth.token.get('email_verified', false) == true
 || (hasProfile() && (isGrandfathered()
 || myUserDoc().get('role', 'member') in ['admin', 'editor'])));
 }
 function ownsNew(field) { return request.resource.data[field] == myUid(); }
 function ownsExisting(field) { return resource.data[field] == myUid(); }
 function changed(keys) {
 return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
 }
 function touched(key) {
 return key in request.resource.data.diff(resource.data).affectedKeys();
 }
 // Does the signed-in user own the project this doc points at?
 function ownsProject(pid) {
 return exists(/databases/$(database)/documents/projects/$(pid))
 && get(/databases/$(database)/documents/projects/$(pid)).data.submitterId == myUid();
 }

 // ---------------------------------------------------------------
 // reports: members report a post, comment or reply (utils/reports.js).
 // Anyone signed in can file one as themselves; only staff read and close them.
 // ---------------------------------------------------------------
 match /reports/{id} {
 allow create: if isSignedIn()
 && request.resource.data.reporterUid == myUid()
 && request.resource.data.status == 'open'
 && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'scam', 'personal', 'other']
 && request.resource.data.get('details', '').size() <= 500
 && request.resource.data.get('excerpt', '').size() <= 300
 && request.resource.data.createdAt == request.time;
 allow read, update: if isReviewer();
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // presence: "Active now" / "Last active ..." (utils/presence.js)
 // Signed-in members can read it; each member writes only their own, with
 // the server's time, so no one can fake being online.
 // ---------------------------------------------------------------
 match /presence/{uid} {
 allow read: if isSignedIn();
 allow create, update: if isSignedIn() && uid == myUid()
 && request.resource.data.keys().hasOnly(['state', 'hidden', 'lastActive'])
 && request.resource.data.state in ['online', 'offline']
 && request.resource.data.hidden is bool
 && request.resource.data.lastActive == request.time;
 allow delete: if isSignedIn() && uid == myUid();
 }

 // ---------------------------------------------------------------
 // users
 // ---------------------------------------------------------------
 match /users/{userId} {
 allow read: if isSignedIn();

 allow create: if isSignedIn() && userId == myUid()
 && request.resource.data.get('role', 'member') != 'admin'
 && !('premium' in request.resource.data)
 && !('companyTier' in request.resource.data) && !('companyTierUntil' in request.resource.data)
 && request.resource.data.get('role', 'member') != 'editor'
 && request.resource.data.get('isVerified', false) == false
 // Join date is the server's time: it decides whether a confirmed email
 // is needed (isGrandfathered), so it can't be backdated or left out.
 && request.resource.data.get('createdAt', null) == request.time;

 // Self-update: cannot change own role, cannot self-award badges.
 allow update: if isSignedIn() && userId == myUid()
 // Members must give their age group to finish sign-up (companies don't).
 && (!touched('onboardingComplete') || request.resource.data.get('onboardingComplete', false) != true
 || request.resource.data.get('isCompany', false) == true
 || request.resource.data.get('ageGroup', null) in ['18plus', '13-17'])
 && (!('role' in request.resource.data)
 || request.resource.data.role == resource.data.role)
 && !touched('badges')
 // Company or member is chosen at sign-up; after onboarding only staff change it.
 && (!touched('isCompany') || resource.data.get('onboardingComplete', false) != true)
 && (!touched('accountType') || resource.data.get('onboardingComplete', false) != true)
 && !touched('badgeCounts')
 && !touched('badgeCount')
 // Company verification is granted by an admin, never self-set:
 // it is what allows a company to post paid projects.
 && !touched('isVerified')
 // Premium is granted by an admin (or payment activation), never self-set.
 && !touched('premium') && !touched('companyTier') && !touched('companyTierUntil')
 // Trainer status (training contracts) is granted by an admin.
 && !touched('isTrainer')
 // Summit attendance is recorded by staff at check-in.
 && !touched('summitAttendance')
 // A learner under 18 (joined through a school) can't remove that flag herself.
 // Under-18 protection: a member can't remove it herself, except automatically
 // once her saved date of birth (dobAt) shows she has turned 18.
 && (!touched('isMinor') || request.resource.data.isMinor == true
 || (resource.data.get('dobAt', null) != null && !touched('dobAt')
 && request.time > resource.data.dobAt + duration.value(6575, 'd')))
 // While marked under 18, the date of birth can't be changed to an earlier one
 // (no making yourself older); She Model Tech staff can correct it.
 && (!touched('dobAt') || resource.data.get('isMinor', false) != true
 || resource.data.get('dobAt', null) == null
 || request.resource.data.dobAt >= resource.data.dobAt)
 // Teacher access is granted by an admin, never self-set.
 && !touched('isTeacher')
 && !touched('teacherSince')
 && !touched('teacherAssignedBy')
 // The Mentor badge is awarded by an admin's approval, never self-set.
 && !touched('mentorApprovedCourses')
 && !touched('mentorBadgeSince')
 // Join date can't be backdated or removed (see isGrandfathered).
 && (!touched('createdAt') || request.resource.data.get('createdAt', null) == request.time);

 allow update: if isAdmin();

 // Badge award at project completion. The lead of a project may add ONE badge
 // (and matching counters/certificate) to a teammate's profile, or to their own
 // as lead, and only for a project they own where that person is on the team.
 // Without this, awarded badges never reached anyone's profile, dashboard, or
 // Talent Board listing (only the separate member_badges record was written).
 allow update: if isSignedIn()
 && request.resource.data.diff(resource.data).affectedKeys()
 .hasOnly(['badges', 'badgeCounts', 'totalBadges', 'certificates'])
 && request.resource.data.get('badges', []).size() == resource.data.get('badges', []).size() + 1
 && request.resource.data.badges[request.resource.data.badges.size() - 1].projectId is string
 && ownsProject(request.resource.data.badges[request.resource.data.badges.size() - 1].projectId)
 && (
 userId in get(/databases/$(database)/documents/projects/$(request.resource.data.badges[request.resource.data.badges.size() - 1].projectId)).data.get('members', [])
 || userId == myUid()
 )
 && request.resource.data.get('totalBadges', 0) == resource.data.get('totalBadges', 0) + 1;

 // Follow / unfollow another member: only your own uid goes in or out of
 // her followers, and the count moves by one with it.
 allow update: if isSignedIn() && userId != myUid()
 && changed(['followers', 'followerCount'])
 && ((!(myUid() in resource.data.get('followers', []))
 && request.resource.data.get('followers', []) == resource.data.get('followers', []).concat([myUid()])
 && request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0) + 1)
 || (myUid() in resource.data.get('followers', [])
 && request.resource.data.get('followers', []) == resource.data.get('followers', []).removeAll([myUid()])
 && request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0) - 1));

 // (Removed: a rule that let ANY signed-in member rewrite another member's
 // badges / badgeCounts / badgeCount. Badge awards come only from the
 // project-lead rule above, which every award in ProjectCompletion.jsx uses:
 // its writes always include totalBadges.)

 allow delete: if isSignedIn() && userId == myUid();
 }

 // ---------------------------------------------------------------
 // cohorts, 8-week cycles, run by reviewers only.
 // ---------------------------------------------------------------
 match /cohorts/{cohortId} {
 allow read: if isSignedIn();
 allow create, update: if isReviewer();
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // waitlist, register interest in an upcoming cohort.
 // ---------------------------------------------------------------
 // Feedback after a project ({projectId}_{uid}): the member writes hers; staff read all.
 match /project_feedback/{id} {
 allow read: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 allow create, update: if isSignedIn() && request.resource.data.uid == myUid()
 && id == request.resource.data.projectId + '_' + myUid()
 && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
 && request.resource.data.recommend in ['yes', 'maybe', 'no'];
 }

 // One-time announcements sent by admins (a record of what was sent).
 match /announcements/{id} {
 allow read, create: if isAdmin();
 }

 // Started a lead application ({projectId}_{uid}); names only.
 match /lead_intent/{id} {
 allow read: if isSignedIn();
 allow create, update: if isSignedIn() && request.resource.data.uid == myUid()
 && id == request.resource.data.projectId + '_' + myUid();
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 }

 // "Notify me when roles open" on coming-soon projects ({projectId}_{uid}).
 match /project_interest/{id} {
 // Names only (no contact details), so any signed-in member may read.
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.uid == myUid()
 && id == request.resource.data.projectId + '_' + myUid();
 // The member, staff, or the project's lead (after telling everyone roles are open).
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isReviewer() || ownsProject(resource.data.projectId));
 }

 match /waitlist/{entryId} {
 allow read: if isSignedIn() && (ownsExisting('userId') || isReviewer());
 allow create: if isSignedIn() && ownsNew('userId');
 allow update: if isSignedIn() && ownsExisting('userId') && ownsNew('userId');
 allow update: if isReviewer();
 // Staff clear entries once the member has been told a project needs a lead.
 allow delete: if isSignedIn() && (ownsExisting('userId') || isReviewer());
 }

 // ---------------------------------------------------------------
 // lead_applications, apply to lead, ranked up to 3 projects.
 // Applicants create and withdraw. ONLY reviewers decide.
 // ---------------------------------------------------------------
 match /lead_applications/{appId} {
 allow read: if isSignedIn() && (ownsExisting('applicantUid') || isReviewer());
 // Staff create the proposer's application when approving a project proposal.
 allow create: if isReviewer() && request.resource.data.status == 'submitted';

 allow create: if isSignedIn()
 && ownsNew('applicantUid')
 && request.resource.data.status == 'submitted'
 // Everyone applying to lead has told us their age group.
 && myUserDoc().get('ageGroup', null) in ['18plus', '13-17']
 && request.resource.data.rankedProjectIds is list
 && request.resource.data.rankedProjectIds.size() <= 3
 && isVerified();

 // Applicant may ONLY withdraw.
 allow update: if isSignedIn()
 && ownsExisting('applicantUid')
 && changed(['status', 'withdrawnAt'])
 && request.resource.data.status == 'withdrawn';

 // Reviewer: interview notes, assign, reject, offer another role or a
 // fallback project from the applicant's ranked choices.
 allow update: if isReviewer();
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // projects
 // ---------------------------------------------------------------
 match /projects/{projectId} {
 function isProjectOwner() {
 return isSignedIn() && resource.data.submitterId == myUid();
 }
 function isProjectMember() {
 return isSignedIn() && (
 (('members' in resource.data) && myUid() in resource.data.members)
 || (('paymentConfirmations' in resource.data)
 && myEmail() in resource.data.paymentConfirmations)
 );
 }
 // On this project's team: the lead, an approved member, an organization
 // observer, or staff. Used for the team-only workspace (forum, private links).
 function onTeam() {
 let p = get(/databases/$(database)/documents/projects/$(projectId)).data;
 return isSignedIn() && (
 isReviewer()
 || p.get('submitterId', '') == myUid()
 || myUid() in p.get('members', [])
 || myEmail() in p.get('members', [])
 || myUid() in p.get('observers', [])
 );
 }
 function appendOnly(field) {
 return !(field in request.resource.data)
 || !(field in resource.data)
 || (request.resource.data[field].hasAll(resource.data[field])
 && request.resource.data[field].size() >= resource.data[field].size());
 }

 allow read: if isSignedIn();

 // Only She Model Tech (admins and editors) creates projects, free or paid.
 // Companies hire through job posts instead.
 allow create: if isReviewer();

 // 1. Admin: full control.
 allow update: if isAdmin();

 // 2. Reviewer: review gate + lead assignment. This is the ONLY path
 // that may set submitterId. There is no first-come self-claim.
 allow update: if isReviewer();

 // 3. Owner: full control of their own project. History arrays are
 // append-only, ownership is frozen, and closing the project needs
 // the owner plus at least one approved member.
 allow update: if isProjectOwner()
 // Featuring a project is a Premium feature.
 && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured']) || isPremiumUser())
 // Leads can't change a project's title, description, problem, weekly plan, brief
 // roles, or dates (She Model Tech sets them). Company posts are the company's own and stay editable.
 && (resource.data.get('isCompanyPost', false) == true
 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['projectTitle', 'projectDescription', 'startDate', 'endDate', 'startAt', 'problemStatement', 'weeklyPlan', 'briefRoles']))
 // Cohort projects: She Model Tech sets the dates and the number of people
 // (leads create the roles within it, and request extra time). When no team
 // size was set, the lead's roles set it once, as she opens the project.
 && (resource.data.get('isCohort', false) != true
 || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['startDate', 'endDate', 'startAt', 'extensionDays', 'isCohort', 'cohortId'])
 && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxTeamSize', 'roleSlots'])
 || (resource.data.get('maxTeamSize', 0) == 0 && resource.data.get('roleSlots', 0) == 0))))
 // Paid cohorts: the lead can't change anything She Model Tech set.
 && (resource.data.get('cohortPaid', false) != true
 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['projectTitle', 'projectDescription', 'industryTrack', 'proposedRoles', 'maxTeamSize', 'roleSlots', 'totalBudget', 'isPaid', 'payPerPerson', 'cohortPaid']))
 && appendOnly('disputeHistory')
 && appendOnly('leaveReasons')
 && appendOnly('activityLog')
 && request.resource.data.submitterId == resource.data.submitterId
 && (
 request.resource.data.get('status', '') == resource.data.get('status', '')
 || !(request.resource.data.get('status', '') in
 ['completed', 'awaiting_payment_confirmation'])
 || request.resource.data.get('members', []).size() >= 1
 );

 // 4. Member payment action: confirm or dispute ONLY their own entry.
 allow update: if isProjectMember()
 && ('paymentConfirmations' in resource.data)
 && myEmail() in resource.data.paymentConfirmations
 && changed(['paymentConfirmations', 'disputeHistory'])
 && request.resource.data.paymentConfirmations
 .diff(resource.data.paymentConfirmations)
 .affectedKeys().hasOnly([myEmail()])
 && request.resource.data.paymentConfirmations[myEmail()].amountDue
 == resource.data.paymentConfirmations[myEmail()].amountDue
 && (request.resource.data.paymentConfirmations[myEmail()].amountPaid
 == resource.data.paymentConfirmations[myEmail()].amountPaid
 || request.resource.data.paymentConfirmations[myEmail()].amountPaid
 == resource.data.paymentConfirmations[myEmail()].amountDue)
 && request.resource.data.paymentConfirmations[myEmail()].status
 in ['confirmed', 'disputed']
 && appendOnly('disputeHistory');

 // 5. Member leaves (the owner cannot leave their own project).
 allow update: if isProjectMember()
 && resource.data.submitterId != myUid()
 && changed(['members', 'leaveReasons', 'disputeHistory'])
 && myUid() in resource.data.members
 && !(myUid() in request.resource.data.members)
 && request.resource.data.members.size() == resource.data.members.size() - 1
 && appendOnly('leaveReasons')
 && appendOnly('disputeHistory');

 // 6. Application counter: up by one when someone applies (ProjectDetail.jsx).
 allow update: if isSignedIn() && changed(['applicationCount'])
 && request.resource.data.get('applicationCount', 0) == resource.data.get('applicationCount', 0) + 1;

 allow delete: if isSignedIn() && (resource.data.submitterId == myUid() || isAdmin());

 match /dispute_messages/{msgId} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.authorUid == myUid() && isVerified();
 allow update, delete: if isSignedIn()
 && (resource.data.authorUid == myUid() || isAdmin());
 }
 // Team-only links and notes (meeting link, details link, notes).
 match /private/{docId} {
 allow read: if onTeam();
 allow write: if isReviewer()
 || get(/databases/$(database)/documents/projects/$(projectId)).data.get('submitterId', '') == myUid();
 }
 // The team's discussion: only the team reads it and posts in it.
 match /forum/{msgId} {
 allow read: if onTeam();
 allow create: if onTeam() && request.resource.data.authorId == myUid() && isVerified();
 allow update: if onTeam() && changed(['reactions', 'reactorInfo']);
 // Authors edit only the text, tags and edit time of their own post or reply.
 allow update: if isSignedIn() && resource.data.authorId == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentions', 'reactions', 'reactorInfo']);
 allow update: if isAdmin();
 allow delete: if isSignedIn()
 && (resource.data.authorId == myUid() || isAdmin());
 }
 }

 // ---------------------------------------------------------------
 // project_applications, contributor applications, reviewed by the lead.
 // ---------------------------------------------------------------
 // Teacher materials: teaching notes and instructor editions for staff only.
 // Never readable by members or companies. Deleting a whole course is admin-only.
 match /teacher_courses/{id} {
 // Staff: full control (deleting a whole course is admin-only).
 allow read, create, update: if isReviewer();
 allow delete: if isAdmin();
 // Teachers: read everything; create and edit only their own; never publish
 // (publishing is staff-only), but they may request it.
 allow read: if isTeacherUser();
 // Organization instructors can read the instructor editions shared with them.
 allow read: if isSignedIn() && myUid() in resource.data.get('orgInstructorUids', []);
 allow create: if isTeacherUser()
 && request.resource.data.createdBy.uid == myUid()
 && !('published' in request.resource.data);
 allow update: if isTeacherUser()
 && resource.data.createdBy.uid == myUid()
 && request.resource.data.createdBy.uid == myUid()
 && !touched('published')
 // Teachers can submit or withdraw; only an admin approves or declines.
 && (!touched('review')
 || request.resource.data.review.status in ['pending', 'withdrawn']);
 allow delete: if isTeacherUser()
 && resource.data.createdBy.uid == myUid()
 && resource.data.get('published', null) == null;
 match /chunks/{n} {
 allow read, write: if isReviewer();
 allow read: if isTeacherUser();
 allow read: if isSignedIn()
 && myUid() in get(/databases/$(database)/documents/teacher_courses/$(id)).data.get('orgInstructorUids', []);
 // getAfter: in a batch the course doc may be created in the same write.
 allow write: if isTeacherUser()
 && (
 (existsAfter(/databases/$(database)/documents/teacher_courses/$(id))
 && getAfter(/databases/$(database)/documents/teacher_courses/$(id)).data.createdBy.uid == myUid())
 || (exists(/databases/$(database)/documents/teacher_courses/$(id))
 && get(/databases/$(database)/documents/teacher_courses/$(id)).data.createdBy.uid == myUid())
 );
 }
 }

 // Applications to become a teacher. One per person (doc id = their uid).
 match /teacher_applications/{uid} {
 allow read: if isSignedIn() && (uid == myUid() || isReviewer());
 allow create: if isSignedIn() && uid == myUid()
 && request.resource.data.applicantUid == myUid()
 && request.resource.data.status == 'pending'
 && isVerified();
 // Re-apply after a decline.
 allow update: if isSignedIn() && uid == myUid()
 && resource.data.status == 'declined'
 && request.resource.data.status == 'pending'
 && request.resource.data.applicantUid == myUid()
 && isVerified();
 allow update, delete: if isAdmin();
 }

 // Courses published to Learning from Teacher. Public to read, like the rest of
 // the Learning catalog; only admins and editors can publish, update, or remove.
 // Gifts recorded by admins (bank transfer, cheque), with acknowledgment letters.
 match /gifts/{id} {
 allow read, write: if isAdmin();
 }

 // Sponsors thanked on the site (companies that funded a cohort). Admins only.
 match /sponsors/{id} {
 allow read: if true;
 allow write: if isAdmin();
 }

 // Monthly count of new conversations for free companies ({uid}_{YYYY-MM}).
 // Only grows, one person at a time, up to 5; can't be deleted by the company.
 match /message_quota/{id} {
 allow read: if isSignedIn() && (resource == null || resource.data.uid == myUid() || isAdmin());
 allow create: if isSignedIn() && id == myUid() + '_' + monthKey()
 && request.resource.data.uid == myUid()
 && request.resource.data.contacts.size() == 1;
 allow update: if isSignedIn() && id == myUid() + '_' + monthKey()
 && request.resource.data.uid == myUid()
 && request.resource.data.contacts.hasAll(resource.data.contacts)
 && request.resource.data.contacts.size() == resource.data.contacts.size() + 1
 && request.resource.data.contacts.size() <= 5;
 allow delete: if isAdmin();
 }

 // Launch switches (admin-only), readable by everyone so the site can adapt.
 match /app_settings/{id} {
 allow read: if true;
 allow write: if isAdmin();
 }

 // Staff edits to the built-in courses (admins and editors).
 match /course_overrides/{id} {
 allow read: if true;
 allow write: if isReviewer();
 match /chunks/{n} {
 allow read: if true;
 allow write: if isReviewer();
 }
 }

 match /learning_courses/{id} {
 allow read: if true;
 allow write: if isReviewer();
 match /chunks/{n} {
 allow read: if true;
 allow write: if isReviewer();
 }
 }

 // Enrolments per course (counted for mentor impact numbers). Anyone can count;
 // a learner can only add or remove their own.
 match /course_enrollments/{courseKey} {
 match /learners/{uid} {
 allow read: if true;
 allow create, update: if isSignedIn() && uid == myUid() && request.resource.data.uid == myUid();
 allow delete: if isSignedIn() && (uid == myUid() || isAdmin());
 }
 }

 // Each learner's course progress (quiz answers and marks, checklist ticks).
 // Private to the learner.
 match /users/{userId}/learning_progress/{courseId} {
 allow read, write: if isSignedIn() && userId == myUid();
 }

 // Job post numbers (utils/jobStats.js): views and Apply clicks, counts only.
 // Members add one at a time; only the posting company and staff can read them.
 match /job_stats/{jobId} {
 allow read: if isReviewer()
 || (isSignedIn() && exists(/databases/$(database)/documents/jobs/$(jobId))
 && get(/databases/$(database)/documents/jobs/$(jobId)).data.companyUid == myUid());
 allow create: if isSignedIn()
 && exists(/databases/$(database)/documents/jobs/$(jobId))
 && request.resource.data.keys().hasOnly(['views', 'applyLink', 'applyEmail', 'interested'])
 && request.resource.data.get('views', 0) in [0, 1]
 && request.resource.data.get('applyLink', 0) in [0, 1]
 && request.resource.data.get('applyEmail', 0) in [0, 1]
 && request.resource.data.get('interested', 0) in [0, 1];
 allow update: if isSignedIn()
 && request.resource.data.keys().hasOnly(['views', 'applyLink', 'applyEmail', 'interested'])
 && request.resource.data.diff(resource.data).affectedKeys().size() == 1
 && (
 request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
 || request.resource.data.get('applyLink', 0) == resource.data.get('applyLink', 0) + 1
 || request.resource.data.get('applyEmail', 0) == resource.data.get('applyEmail', 0) + 1
 || request.resource.data.get('interested', 0) == resource.data.get('interested', 0) + 1
 );
 allow delete: if isAdmin();
 }


 // Jobs board. Anyone signed in can browse. Posting is Premium, for verified
 // companies (and staff). Only the posting company or an admin can change a job;
 // featuring a job needs Premium.
 match /jobs/{jobId} {
 // A verified company that can post jobs right now: with tiers on, any active
 // tier; before that, the Job posting switch decides.
 function canPostJobs() {
 return myUserDoc().get('isCompany', false) == true
 && myUserDoc().get('isVerified', false) == true
 && ((featureOn('companyTiers') && tierRank() >= 1) || (!featureOn('companyTiers') && featureOn('jobPosting')));
 }
 allow read: if isSignedIn();
 allow create: if isSignedIn()
 && request.resource.data.companyUid == myUid()
 && (isReviewer() || canPostJobs())
 && request.resource.data.title is string && request.resource.data.title.size() <= 120
 && request.resource.data.description is string && request.resource.data.description.size() <= 8000
 && request.resource.data.get('companyName', '') is string && request.resource.data.get('companyName', '').size() <= 120
 && request.resource.data.featured == false
 // Promoted to members: Champion only.
 && (request.resource.data.get('promoted', false) == false || tierRank() >= 3 || isReviewer())
 && !('announcedAt' in request.resource.data)
 && isVerified();
 // Staff (admins and editors) manage any post. A company edits its own while
 // it can post jobs; once it can't (tier ended, verification removed) it can
 // only close a post or ask for it to be deleted. It can't republish a post it
 // asked to delete (staff decide), and only Champions feature or promote.
 allow update: if isSignedIn() && (isReviewer() || (resource.data.companyUid == myUid()
 && request.resource.data.companyUid == myUid()
 && !(resource.data.get('status', '') == 'removal_requested' && request.resource.data.get('status', '') != 'removal_requested')
 && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['announcedAt', 'announcedTo', 'closingNoticeFor', 'closedNoticeFor'])
 && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured', 'promoted']) || tierRank() >= 3)
 && (canPostJobs()
 || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBeforeRemoval', 'removalRequest', 'updatedAt'])
 && request.resource.data.status in ['closed', 'removal_requested']))));
 // Only She Model Tech staff delete job posts; companies request deletion.
 allow delete: if isReviewer();
 }

 // Members' project proposals (projects they'd like to lead). Staff review them.
 match /project_proposals/{id} {
 // Proposals are closed: projects come from She Model Tech cohorts. Staff can
 // still review any that were sent before.
 allow create: if false && isSignedIn() && request.resource.data.uid == myUid()
 && request.resource.data.status == 'new'
 && request.resource.data.title is string && request.resource.data.title.size() <= 120
 && request.resource.data.description is string && request.resource.data.description.size() <= 4000
 && request.resource.data.get('whyLead', '').size() <= 1500;
 allow read: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 allow update: if isReviewer();
 allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == myUid() && resource.data.status == 'new');
 }

 // Companies asking to sponsor a She Model Tech cohort.
 match /sponsor_requests/{id} {
 // Retired: companies no longer sponsor cohorts. Existing requests stay readable.
 allow create: if false;
 allow read: if isReviewer() || (isSignedIn() && resource.data.companyUid == myUid());
 allow update: if isReviewer();
 allow delete: if isAdmin();
 }

 // Organizations: training contract and course licensing requests. Anyone can
 // submit one from the public page; staff manage them; assigned mentors can
 // read the ones they're assigned to.
 match /org_requests/{id} {
 // Organizations must be signed in to send a request (so we can update them
 // and chat with them on the platform).
 // Retired: She Model Tech no longer offers organization training. Old requests stay readable.
 allow create: if false
 && request.resource.data.orgName is string && request.resource.data.orgName.size() > 0 && request.resource.data.orgName.size() <= 150
 && request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 200
 && request.resource.data.get('topics', '').size() <= 1500
 && request.resource.data.get('message', '').size() <= 2000
 && request.resource.data.assignedMentorUids.size() == 0;
 allow read: if isReviewer()
 || (isSignedIn() && (myUid() in resource.data.get('assignedMentorUids', []) || resource.data.get('requesterUid', '') == myUid()));
 allow update, delete: if isReviewer();
 }

 // Organizations with learners (course licensing). Staff create and manage them;
 // an organization's admins read its members; learners join with consent.
 match /organizations/{orgId} {
 allow read: if isSignedIn();
 allow write: if isReviewer();
 match /members/{uid} {
 allow read: if isSignedIn() && (uid == myUid() || isReviewer()
 || myUid() in get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids);
 allow create: if isSignedIn() && uid == myUid()
 && request.resource.data.uid == myUid()
 && request.resource.data.consent == true
 && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active'
 && (request.resource.data.minor == false
 || get(/databases/$(database)/documents/organizations/$(orgId)).data.get('allowMinors', false) == true);
 allow delete: if isSignedIn() && (uid == myUid() || isAdmin()
 || myUid() in get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids);
 }
 }

 // Events (all online). Anyone can see published events; staff manage them.
 // Member-hosted events (Events → Host an event): adult members (not companies)
 // submit an event that waits for staff review. While it is unpublished, the
 // host can edit or delete it; staff publish it (or decline it with a note).
 function isAdultMember() {
 return isVerified() && hasProfile()
 && myUserDoc().get('ageGroup', null) == '18plus'
 && myUserDoc().get('isCompany', false) != true;
 }
 // A team event (from the project workspace) may only be linked to her own project.
 function onProjectTeam(pid) {
 let p = get(/databases/$(database)/documents/projects/$(pid)).data;
 return p.get('submitterId', '') == myUid() || myUid() in p.get('members', []);
 }
 function validHostedEvent(d) {
 return d.keys().hasOnly(['title', 'category', 'startAt', 'durationMins', 'hosts', 'description', 'capacity',
 'imageUrl', 'images', 'published', 'status', 'hostUid', 'hostName', 'reviewStatus', 'reviewNote', 'createdAt', 'updatedAt',
 'projectId', 'projectTitle'])
 && (!('images' in d) || (d.images is list && d.images.size() <= 5))
 && (d.get('projectId', null) == null || onProjectTeam(d.projectId))
 && d.hostUid == myUid()
 && d.published == false
 && d.status == 'scheduled'
 && d.reviewStatus == 'pending'
 && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
 && d.description is string && d.description.size() <= 4000
 && d.category in ['workshop', 'talk', 'conference', 'demoday', 'shoutout']
 && d.startAt is string
 && d.durationMins is number && d.durationMins >= 15 && d.durationMins <= 600
 && noLink(d.title) && noLink(d.description) && noLink(d.get('hosts', ''));
 }
 match /events/{id} {
 allow read: if (resource != null && resource.data.get('published', false) == true) || isReviewer()
 || (isSignedIn() && resource != null && resource.data.get('hostUid', '') == myUid());
 allow write: if isReviewer();
 allow create: if isAdultMember() && validHostedEvent(request.resource.data);
 allow update: if isAdultMember() && resource.data.get('hostUid', '') == myUid()
 && resource.data.get('published', false) == false
 && validHostedEvent(request.resource.data)
 && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid', 'createdAt', 'reviewNote']);
 allow delete: if isSignedIn() && resource.data.get('hostUid', '') == myUid()
 && resource.data.get('published', false) == false;
 // The joining link: staff, the host, and people who have a place.
 match /private/{doc} {
 allow read: if isReviewer() || (isSignedIn()
 && exists(/databases/$(database)/documents/eventRegistrations/$(id + '_' + myUid()))
 && get(/databases/$(database)/documents/eventRegistrations/$(id + '_' + myUid())).data.status == 'registered');
 allow read: if isSignedIn()
 && get(/databases/$(database)/documents/events/$(id)).data.get('hostUid', '') == myUid();
 allow write: if isSignedIn()
 && get(/databases/$(database)/documents/events/$(id)).data.get('hostUid', '') == myUid()
 && request.resource.data.keys().hasOnly(['joinUrl'])
 && safeJoinLink(request.resource.data.joinUrl);
 allow write: if isReviewer();
 }
 }
 // The recording link: any signed-in member.
 match /events/{id}/members/{doc} {
 allow read: if isSignedIn();
 allow write: if isReviewer();
 }
 // eventRegistrations/{eventId}_{uid}: no names or emails, so members may read
 // them (to count places). Reminders and waitlist moves are done by the server.
 match /eventRegistrations/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn()
 && request.resource.data.uid == myUid()
 && id == request.resource.data.eventId + '_' + myUid()
 && request.resource.data.status in ['registered', 'waitlist']
 && request.resource.data.keys().hasOnly(['eventId', 'uid', 'status', 'present', 'projectId', 'projectTitle', 'createdAt'])
 && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('published', false) == true
 && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('status', 'scheduled') != 'cancelled';
 allow update: if isReviewer();
 allow delete: if isReviewer() || (isSignedIn() && resource.data.uid == myUid());
 }

 // The Summit (retired; kept so old records stay readable).
 match /summits/{id} {
 allow read: if true;
 allow write: if isReviewer();
 }
 match /summitRegistrations/{id} {
 allow read: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 // Recruiting partners (confirmed by staff) see attendees who opted in.
 allow read: if isSignedIn() && resource.data.get('shareProfile', false) == true
 && myUid() in get(/databases/$(database)/documents/summits/$(resource.data.summitId)).data.get('recruiterUids', []);
 allow create: if isSignedIn() && request.resource.data.uid == myUid()
 && id == request.resource.data.summitId + '_' + myUid()
 && request.resource.data.checkedIn == false;
 allow update: if isReviewer()
 || (isSignedIn() && resource.data.uid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareProfile', 'workshops']));
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 }
 // "Notify me" for the Summit ({summitId}_{uid}).
 match /summitInterest/{id} {
 allow read: if isSignedIn() && (resource == null || resource.data.uid == myUid() || isReviewer());
 allow create: if isSignedIn() && request.resource.data.uid == myUid()
 && id == request.resource.data.summitId + '_' + myUid();
 allow update: if isReviewer();
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 }
 // Applications to join the She Model Tech team (anyone may apply; admins decide).
 // No web links in public form text or member-hosted events (phishing safety;
 // src/utils/noLinks.js shows the same check before sending).
 function noLink(t) {
 return !(t is string) || !t.matches('(?is).*(https?:|www\\.|[a-z0-9-]+\\.(com|net|org|io|ly|co|me|xyz|app|dev|info|biz|link|site|online|top|click|ru|cn|tk|gl|gd|cc|to|in|ng|uk|us)/).*');
 }
 // Join the team: a LinkedIn, GitHub, Behance, or Dribbble profile only.
 function safeProfileLink(t) {
 return t is string && t.matches('(?i)https://([a-z0-9-]+\\.)*(linkedin\\.com|github\\.com|behance\\.net|dribbble\\.com)(/[^\\s]*)?');
 }
 // Hosted events: the joining link must be a known meeting service.
 function safeJoinLink(t) {
 return t == '' || (t is string && t.matches('(?i)https://([a-z0-9-]+\\.)*(zoom\\.us|meet\\.google\\.com|teams\\.microsoft\\.com|teams\\.live\\.com|webex\\.com|streamyard\\.com|youtube\\.com|youtu\\.be)(/[^\\s]*)?'));
 }
 match /team_applications/{id} {
 allow create: if request.resource.data.status == 'new'
 && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
 && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
 && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
 && request.resource.data.linkedinOrPortfolio is string && request.resource.data.linkedinOrPortfolio.size() <= 300
 && request.resource.data.socialPlatform in ['Instagram', 'X', 'LinkedIn']
 && request.resource.data.socialHandle is string && request.resource.data.socialHandle.size() <= 100
 && request.resource.data.role in ['community', 'communication', 'social', 'brand', 'partnership', 'sponsorship', 'program', 'designer', 'content', 'developer']
 && request.resource.data.otherRoles is list && request.resource.data.otherRoles.size() <= 2
 && request.resource.data.why is string && request.resource.data.why.size() <= 3000
 && request.resource.data.get('hours', '').size() <= 60
 && safeProfileLink(request.resource.data.linkedinOrPortfolio)
 && noLink(request.resource.data.name) && noLink(request.resource.data.phone) && noLink(request.resource.data.socialHandle)
 && noLink(request.resource.data.why) && noLink(request.resource.data.get('hours', ''))
 && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'linkedinOrPortfolio', 'socialPlatform', 'socialHandle', 'role', 'otherRoles', 'hours', 'why', 'status', 'createdAt']);
 allow read, update, delete: if isAdmin();
 }

 // Founders (Founders page): members 13+ (not companies) with at least one
 // badge pitch an idea for She Model Tech Conference; one pitch per member, at
 // founder_pitches/{uid}. Staff (admins and editors) accept or decline. Accepted
 // pitches are readable by any signed-in member (the Founders page); others
 // only by their owner and staff. No web links in any text.
 function canPitch() {
 return isVerified() && hasProfile()
 && myUserDoc().get('isCompany', false) != true
 && myUserDoc().get('ageGroup', null) in ['18plus', '13-17']
 && myUserDoc().get('badges', []).size() > 0;
 }
 function validPitch(d) {
 return d.uid == myUid()
 && d.name is string && d.name.size() > 0 && d.name.size() <= 120
 && d.ideaName is string && d.ideaName.size() >= 2 && d.ideaName.size() <= 80
 && d.problem is string && d.problem.size() >= 20 && d.problem.size() <= 600
 && d.audience is string && d.audience.size() >= 5 && d.audience.size() <= 300
 && d.solution is string && d.solution.size() >= 20 && d.solution.size() <= 800
 && d.stage in ['idea', 'prototype', 'live']
 && d.tracksNeeded is list && d.tracksNeeded.size() >= 1 && d.tracksNeeded.size() <= 6
 && d.rolesNeeded is string && d.rolesNeeded.size() <= 300
 && d.why is string && d.why.size() >= 20 && d.why.size() <= 800
 && noLink(d.name) && noLink(d.ideaName) && noLink(d.problem) && noLink(d.audience)
 && noLink(d.solution) && noLink(d.rolesNeeded) && noLink(d.why);
 }
 match /founder_pitches/{uid} {
 allow read: if isSignedIn() && (uid == myUid() || isReviewer() || resource.data.get('status', '') == 'accepted');
 allow create: if isSignedIn() && uid == myUid() && canPitch()
 && validPitch(request.resource.data) && request.resource.data.status == 'pending'
 && request.resource.data.keys().hasOnly(['uid', 'name', 'ideaName', 'problem', 'audience', 'solution', 'stage', 'tracksNeeded', 'rolesNeeded', 'why', 'status', 'createdAt', 'updatedAt']);
 allow update: if isSignedIn() && (
 // The founder sends a pending or declined pitch again (back to review).
 (uid == myUid() && canPitch() && resource.data.status in ['pending', 'declined']
 && validPitch(request.resource.data) && request.resource.data.status == 'pending'
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ideaName', 'problem', 'audience', 'solution', 'stage', 'tracksNeeded', 'rolesNeeded', 'why', 'status', 'updatedAt']))
 // An accepted founder updates the tracks and roles she needs.
 || (uid == myUid() && resource.data.status == 'accepted'
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tracksNeeded', 'rolesNeeded', 'acceptingTeam', 'updatedAt'])
 && request.resource.data.get('acceptingTeam', true) is bool
 && request.resource.data.tracksNeeded is list && request.resource.data.tracksNeeded.size() >= 1 && request.resource.data.tracksNeeded.size() <= 6
 && request.resource.data.rolesNeeded is string && request.resource.data.rolesNeeded.size() <= 300 && noLink(request.resource.data.rolesNeeded))
 // Staff decide.
 || (isReviewer() && request.resource.data.status in ['pending', 'accepted', 'declined']
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionNote', 'decidedBy', 'decidedAt'])));
 // The founder withdraws her pitch; admins remove spam.
 allow delete: if isSignedIn() && (uid == myUid() || isAdmin());
 }

 // Founder team groups: founder_groups/{founderUid}, one per accepted founder.
 // The founder invites members with at least one badge (one at a time); each
 // invitee joins or declines herself, so nobody is added without agreeing. Up
 // to 20 people (members + invites). Any signed-in member can see a group's
 // name and members (shown on profiles); only members read the chat. Staff
 // (admins and editors) can read the chat only after a member reports the
 // group. The founder archives (read-only), reopens, or deletes it.
 function foundersAccepted(uid) {
 return exists(/databases/$(database)/documents/founder_pitches/$(uid))
 && get(/databases/$(database)/documents/founder_pitches/$(uid)).data.get('status', '') == 'accepted';
 }
 function badgeHolder(uid) {
 return get(/databases/$(database)/documents/users/$(uid)).data.get('badges', []).size() > 0
 && get(/databases/$(database)/documents/users/$(uid)).data.get('isCompany', false) != true;
 }
 function groupOnlyChanges(keys) {
 return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
 }
 match /founder_groups/{gid} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && gid == myUid() && foundersAccepted(myUid())
 && request.resource.data.founderUid == myUid()
 && request.resource.data.members == [myUid()]
 && request.resource.data.invited == []
 && request.resource.data.status == 'active'
 && request.resource.data.reported == false
 && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
 && request.resource.data.memberNames is map
 && request.resource.data.keys().hasOnly(['founderUid', 'name', 'members', 'memberNames', 'invited', 'status', 'reported', 'createdAt', 'updatedAt', 'lastMessageAt']);
 allow update: if isSignedIn() && (
 // Founder invites one member with a badge (room for 20 in all).
 (gid == myUid() && groupOnlyChanges(['invited', 'updatedAt'])
 && request.resource.data.invited.size() == resource.data.invited.size() + 1
 && request.resource.data.invited.hasAll(resource.data.invited)
 && !(request.resource.data.invited[request.resource.data.invited.size() - 1] in resource.data.members)
 && badgeHolder(request.resource.data.invited[request.resource.data.invited.size() - 1])
 && request.resource.data.members.size() + request.resource.data.invited.size() <= 20)
 // Founder cancels invites, removes members (never herself), renames,
 // archives or reopens.
 || (gid == myUid() && groupOnlyChanges(['invited', 'members', 'memberNames', 'name', 'status', 'updatedAt'])
 && resource.data.invited.hasAll(request.resource.data.invited)
 && resource.data.members.hasAll(request.resource.data.members)
 && myUid() in request.resource.data.members
 && request.resource.data.status in ['active', 'archived']
 && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80)
 // An invitee joins: she moves herself from invited to members.
 || (myUid() in resource.data.invited && groupOnlyChanges(['invited', 'members', 'memberNames', 'updatedAt'])
 && request.resource.data.invited == resource.data.invited.removeAll([myUid()])
 && request.resource.data.members == resource.data.members.concat([myUid()]))
 // An invitee declines, or a member leaves (not the founder).
 || (gid != myUid() && (myUid() in resource.data.invited || myUid() in resource.data.members)
 && groupOnlyChanges(['invited', 'members', 'memberNames', 'updatedAt'])
 && request.resource.data.invited == resource.data.invited.removeAll([myUid()])
 && request.resource.data.members == resource.data.members.removeAll([myUid()]))
 // A member marks the group reported (lets staff read it), or a message
 // moves the group to the top.
 || (myUid() in resource.data.members && groupOnlyChanges(['reported', 'reportedAt', 'lastMessageAt'])
 && request.resource.data.get('reported', false) in [true, resource.data.get('reported', false)])
 // Staff close a report.
 || (isReviewer() && groupOnlyChanges(['reported', 'reportedAt']) && request.resource.data.reported == false));
 allow delete: if isSignedIn() && (gid == myUid() || isAdmin());

 match /messages/{mid} {
 allow read: if isSignedIn()
 && (myUid() in get(/databases/$(database)/documents/founder_groups/$(gid)).data.members
 || (isReviewer() && get(/databases/$(database)/documents/founder_groups/$(gid)).data.get('reported', false) == true));
 allow create: if isSignedIn()
 && myUid() in get(/databases/$(database)/documents/founder_groups/$(gid)).data.members
 && get(/databases/$(database)/documents/founder_groups/$(gid)).data.status == 'active'
 && request.resource.data.senderUid == myUid()
 && request.resource.data.text is string && request.resource.data.text.size() <= 2000
 && request.resource.data.images is list && request.resource.data.images.size() <= 3
 && (request.resource.data.text.size() > 0 || request.resource.data.images.size() > 0)
 && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'images', 'createdAt']);
 allow update: if isSignedIn() && resource.data.senderUid == myUid()
 && get(/databases/$(database)/documents/founder_groups/$(gid)).data.status == 'active'
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
 && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
 // Her own message; the founder moderates any message; admins.
 allow delete: if isSignedIn() && (resource.data.senderUid == myUid() || gid == myUid() || isAdmin());
 }
 }

 // Funding requests from the "Fund a cohort" form on Support our mission.
 // Anyone can send one (signed in or not); only admins read and manage them
 // (Admin → Sponsors). The server sends the alert emails (api/public-request).
 match /funding_requests/{id} {
 allow create: if request.resource.data.status == 'new'
 && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
 && request.resource.data.organization is string && request.resource.data.organization.size() <= 150
 && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
 && request.resource.data.giverType in ['company', 'foundation', 'individual', 'other']
 && request.resource.data.fundingFor in ['cohort', 'team', 'laptops', 'unsure']
 && request.resource.data.amount in ['under1k', '1k-5k', '5k-20k', 'over20k', 'unsure']
 && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000
 && request.resource.data.createdAt == request.time
 && noLink(request.resource.data.name) && noLink(request.resource.data.organization) && noLink(request.resource.data.phone) && noLink(request.resource.data.message)
 && request.resource.data.keys().hasOnly(['name', 'email', 'organization', 'phone', 'giverType', 'fundingFor', 'amount', 'message', 'status', 'createdAt']);
 allow read, update, delete: if isAdmin();
 }

 // Contact us (shemodeltech.com/contact): anyone can send a message, signed in
 // or not, so the team's email address never has to be shown on the site.
 // Only admins read, update, or delete them (Admin → Contact messages).
 match /contact_messages/{id} {
 allow create: if request.resource.data.status == 'new'
 && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
 && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
 && request.resource.data.topic in ['general', 'letter', 'certificate', 'account', 'privacy', 'other']
 && request.resource.data.reference is string && request.resource.data.reference.size() <= 120
 && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000
 && request.resource.data.createdAt == request.time
 && noLink(request.resource.data.name) && noLink(request.resource.data.reference) && noLink(request.resource.data.message)
 && request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'reference', 'message', 'status', 'createdAt']);
 allow read, update, delete: if isAdmin();
 }

 match /summitPartners/{id} {
 // Retired: the Summit was replaced by Events. Old requests stay readable.
 allow create: if false;
 allow read: if isReviewer() || (isSignedIn() && resource.data.get('companyUid', '') == myUid());
 allow update, delete: if isReviewer();
 }

 // Course discussion forums: questions, discussions, and capstone posts.
 match /course_forum/{courseKey} {
 match /threads/{threadId} {
 allow read: if true;
 allow create: if canJoinCourse(courseKey)
 && request.resource.data.uid == myUid()
 && request.resource.data.kind in ['question', 'discussion', 'capstone']
 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
 && request.resource.data.body is string && request.resource.data.body.size() <= 5000
 && request.resource.data.replyCount == 0
 // Capstones start as waiting for review; nobody can approve their own.
 && (request.resource.data.kind == 'capstone'
 ? request.resource.data.get('review', {}).get('status', '') == 'pending'
 : !('review' in request.resource.data))
 // A mentor course's id, if given, must be this forum's course.
 && (!('learningId' in request.resource.data)
 || courseKey == request.resource.data.track + '__p-' + request.resource.data.learningId)
 && isVerified();
 // Capstone review: admins and editors, or the mentor who wrote this course
 // (mentor courses only). Never the learner who posted it.
 allow update: if isSignedIn()
 && resource.data.get('kind', '') == 'capstone'
 && resource.data.uid != myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])
 && request.resource.data.review.status in ['approved', 'changes']
 && (isReviewer()
 || ('learningId' in resource.data
 && get(/databases/$(database)/documents/learning_courses/$(resource.data.learningId)).data.get('authorUid', '') == myUid()));
 // Anyone signed in can bump the reply count when replying, or set their own
 // emoji reaction; nothing else.
 allow update: if canJoinCourse(courseKey) && (
 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastAt'])
 && request.resource.data.replyCount >= resource.data.get('replyCount', 0) - 1)
 || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()]))
 );
 // The author edits her own post: title, details, link, tags and edit time only.
 allow update: if isSignedIn() && resource.data.uid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'link', 'editedAt', 'mentions'])
 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
 && request.resource.data.body is string && request.resource.data.body.size() <= 5000
 && request.resource.data.editedAt == request.time
 && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20;
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 match /replies/{replyId} {
 allow read: if true;
 allow create: if canJoinCourse(courseKey)
 && request.resource.data.uid == myUid()
 && request.resource.data.body is string
 && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
 // A nested reply points at the reply it answers (same post).
 && (request.resource.data.get('parentReplyId', null) == null || request.resource.data.parentReplyId is string)
 && isVerified();
 // "Already told the author about my reaction" mark: each person sets only her own.
 allow update: if isSignedIn()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionNotified'])
 && request.resource.data.get('reactionNotified', {}).diff(resource.data.get('reactionNotified', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.reactionNotified[myUid()] == true;
 // The author edits her own reply; enrolled members set only their own reaction.
 allow update: if isSignedIn() && (
 (resource.data.uid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt', 'mentions'])
 && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
 && request.resource.data.editedAt == request.time
 && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20)
 || (canJoinCourse(courseKey)
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()]))
 );
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 }
 }
 }

 // Mentor Hub forums: private to mentors and staff.
 match /teacher_forum/{courseKey} {
 match /threads/{threadId} {
 allow read: if isTeacherUser() || isReviewer();
 allow create: if (isTeacherUser() || isReviewer())
 && request.resource.data.uid == myUid()
 && request.resource.data.kind in ['question', 'discussion', 'capstone']
 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
 && request.resource.data.body is string && request.resource.data.body.size() <= 5000
 && request.resource.data.replyCount == 0;
 // Anyone signed in can bump the reply count when replying, or set their own
 // emoji reaction; nothing else.
 allow update: if isSignedIn() && (
 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastAt'])
 && request.resource.data.replyCount >= resource.data.get('replyCount', 0) - 1)
 || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()]))
 );
 // The author edits her own post: title, details, link, tags and edit time only.
 allow update: if isSignedIn() && resource.data.uid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'link', 'editedAt', 'mentions'])
 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
 && request.resource.data.body is string && request.resource.data.body.size() <= 5000
 && request.resource.data.editedAt == request.time
 && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20;
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 match /replies/{replyId} {
 allow read: if isTeacherUser() || isReviewer();
 allow create: if (isTeacherUser() || isReviewer())
 && request.resource.data.uid == myUid()
 && request.resource.data.body is string
 && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
 // A nested reply points at the reply it answers (same post).
 && (request.resource.data.get('parentReplyId', null) == null || request.resource.data.parentReplyId is string);
 // "Already told the author about my reaction" mark: each person sets only her own.
 allow update: if isSignedIn()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionNotified'])
 && request.resource.data.get('reactionNotified', {}).diff(resource.data.get('reactionNotified', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.reactionNotified[myUid()] == true;
 // The author edits her own reply; enrolled members set only their own reaction.
 allow update: if isSignedIn() && (
 (resource.data.uid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt', 'mentions'])
 && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
 && request.resource.data.editedAt == request.time
 && request.resource.data.get('mentions', []) is list && request.resource.data.get('mentions', []).size() <= 20)
 || ((isTeacherUser() || isReviewer())
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()]))
 );
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 }
 }
 }

 // Public course numbers for the catalog (rating, enrolled, completed), one
 // document written by the daily job and by staff (utils/courseStats.js).
 // Member directory for the Talent Board and Search (lib/memberIndex.js):
 // built by the server only; signed-in members can read it. No emails, no
 // learners under 18.
 match /public_index/{id} {
 allow read: if isSignedIn();
 allow write: if false;
 }

 match /public_stats/{id} {
 allow read: if true;
 allow write: if isReviewer();
 }

 // Course page views, for staff only. Anyone viewing a course adds one.
 match /course_views/{key} {
 allow read: if isReviewer();
 allow create: if key.matches('^[A-Za-z0-9_-]{1,300}$')
 && request.resource.data.keys().hasOnly(['views'])
 && request.resource.data.views == 1;
 allow update: if request.resource.data.keys().hasOnly(['views'])
 && request.resource.data.views == resource.data.get('views', 0) + 1;
 allow delete: if isAdmin();
 }

 // Ratings, reactions, and comments on mentor courses in Learning.
 match /course_feedback/{courseKey} {
 match /ratings/{uid} {
 allow read: if true;
 allow create, update: if canJoinCourse(courseKey) && uid == myUid()
 && request.resource.data.uid == myUid()
 && request.resource.data.stars is int
 && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
 && isVerified();
 allow delete: if isSignedIn() && (uid == myUid() || isAdmin());
 }
 match /reactions/{uid} {
 allow read: if true;
 allow create, update: if canJoinCourse(courseKey) && uid == myUid()
 && request.resource.data.uid == myUid()
 && request.resource.data.type in ['helpful', 'love', 'insightful', 'inspiring'];
 allow delete: if isSignedIn() && (uid == myUid() || isAdmin());
 }
 match /comments/{id} {
 allow read: if true;
 allow create: if canJoinCourse(courseKey)
 && request.resource.data.uid == myUid()
 && request.resource.data.text is string
 && request.resource.data.text.size() > 0
 && request.resource.data.text.size() <= 2000
 && isVerified();
 allow update: if false;
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 }
 }

 // Mentors' requests for a recommendation or volunteer service letter.
 match /mentor_letter_requests/{id} {
 allow read: if isSignedIn() && (resource.data.uid == myUid() || isReviewer());
 allow create: if isTeacherUser()
 && request.resource.data.uid == myUid()
 && request.resource.data.status == 'pending'
 && request.resource.data.type in ['recommendation', 'volunteer']
 // A recommendation letter only after the mentor's first published course.
 && (request.resource.data.type == 'volunteer' || myUserDoc().get('mentorApprovedCourses', 0) >= 1);
 // A mentor can withdraw a request that hasn't been handled yet.
 allow delete: if isSignedIn() && resource.data.uid == myUid() && resource.data.status == 'pending';
 // Admins and editors handle requests (mark sent with the letter, or decline).
 allow update: if isReviewer();
 allow delete: if isAdmin();
 }

 // Certificates of completion for Learning courses. Public so anyone with the
 // link can verify one; a learner can only issue their own; never edited.
 match /learning_certificates/{id} {
 allow read: if true;
 // Course certificates are issued only by the server (it checks the course
 // is finished), so the website can't create them.
 // Mentor certificates: issued by an admin or editor at approval, or by the
 // mentor for their own course once it is published.
 allow create: if isReviewer() && request.resource.data.type == 'mentor' && !('email' in request.resource.data);
 allow create: if isSignedIn()
 && request.resource.data.type == 'mentor'
 && request.resource.data.uid == myUid()
 && id.matches(myUid() + '_mentor_.*')
 && !('email' in request.resource.data)
 && get(/databases/$(database)/documents/teacher_courses/$(request.resource.data.courseId)).data.createdBy.uid == myUid()
 && get(/databases/$(database)/documents/teacher_courses/$(request.resource.data.courseId)).data.get('published', null) != null;
 allow update: if false;
 allow delete: if isAdmin();
 }

 // Project deletion requests: a lead asks an admin to delete their project.
 match /deletionRequests/{id} {
 allow create: if isSignedIn()
 && request.resource.data.ownerId == myUid()
 && request.resource.data.status == 'pending'
 && request.resource.data.projectId is string
 && ownsProject(request.resource.data.projectId);
 allow read: if isReviewer() || (isSignedIn() && resource.data.ownerId == myUid());
 allow update, delete: if isAdmin();
 }

 match /project_applications/{id} {
 allow read: if isSignedIn();
 // Paid projects are for members 18 and older who confirmed their age.
 allow create: if isSignedIn()
 && request.resource.data.applicantUid == myUid()
 && request.resource.data.status == 'submitted'
 // Everyone applying has told us their age group.
 && myUserDoc().get('ageGroup', null) in ['18plus', '13-17']
 && (get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.get('isPaid', false) != true
 || (myUserDoc().get('isMinor', false) != true && myUserDoc().get('adultConfirmedAt', null) != null))
 && isVerified();
 allow update: if isReviewer();
 // The project lead approves / rejects / suggests a better-fit role.
 allow update: if isSignedIn() && ownsProject(resource.data.projectId);
 // Applicant may change her badge track (one per project) until completion.
 allow update: if isSignedIn()
 && resource.data.applicantUid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badgeTrack'])
 && request.resource.data.badgeTrack in ['development', 'quality-assurance', 'design', 'security', 'mentorship', 'leadership']
 && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.get('status', '') != 'completed';
 // Applicant may ONLY leave.
 allow update: if isSignedIn()
 && resource.data.applicantUid == myUid()
 && changed(['status', 'leftAt', 'leaveReason'])
 && request.resource.data.status == 'left';
 allow delete: if isAdmin()
 || (isSignedIn() && resource.data.applicantUid == myUid());
 }

 // ===============================================================
 // member_badges, THE PRODUCT. Locked down.
 // Only creatable by the owner of the project the badge came from,
 // or an admin. Immutable once awarded.
 // ===============================================================
 match /member_badges/{id} {
 allow read: if isSignedIn();
 allow create: if isAdmin()
 || (isSignedIn()
 && request.resource.data.projectId is string
 && ownsProject(request.resource.data.projectId));
 allow update, delete: if isAdmin();
 }

 // certificates, same posture as badges.
 match /certificates/{id} {
 allow read: if isSignedIn();
 allow create: if isAdmin()
 || (isSignedIn()
 && request.resource.data.projectId is string
 && ownsProject(request.resource.data.projectId));
 allow update, delete: if isAdmin();
 }


 // ===============================================================
 // COMPANY-HOSTED COHORTS
 // A subscribing, verified company owns the brief, hires every role,
 // reviews its own applicants and PAYS members directly.
 // Critically: these NEVER award badges (see member_badges above) and
 // are never reviewed by us. `awardsBadges` is forced false on create.
 // ===============================================================
 match /company_cohorts/{id} {
 function hostingCompany() {
 return isSignedIn() && resource.data.companyId == myUid();
 }
 function isCohortMember() {
 return isSignedIn() && ('members' in resource.data)
 && myUid() in resource.data.members;
 }

 allow read: if isSignedIn();

 // Only the company itself can create, and it cannot claim to award
 // badges or to have been reviewed by She Model Tech.
 // Retired: companies no longer host cohorts. Existing ones stay readable.
 allow create: if isReviewer();

 allow update: if isReviewer();
 // The company runs its own project.
 allow update: if hostingCompany()
 && request.resource.data.companyId == resource.data.companyId
 && request.resource.data.awardsBadges == false;

 // A member may ONLY confirm or dispute her own payment entry, and add
 // to the report/dispute trail. She cannot change what she is owed.
 allow update: if isCohortMember()
 && request.resource.data.diff(resource.data).affectedKeys()
 .hasOnly(['payments', 'disputeHistory', 'reports', 'status', 'updatedAt'])
 && request.resource.data.payments.diff(resource.data.payments)
 .affectedKeys().hasOnly([myEmail()])
 && request.resource.data.payments[myEmail()].amountDue
 == resource.data.payments[myEmail()].amountDue;

 allow delete: if isAdmin();
 }

 match /company_cohort_applications/{id} {
 function hostOf(cid) {
 return get(/databases/$(database)/documents/company_cohorts/$(cid))
 .data.companyId == myUid();
 }
 allow read: if isSignedIn();
 // Apply as yourself, always starting as 'submitted'.
 allow create: if isSignedIn()
 && request.resource.data.applicantUid == myUid()
 && request.resource.data.status == 'submitted'
 && isVerified();
 allow update: if isReviewer();
 // The hosting company approves / rejects / schedules interviews.
 allow update: if isSignedIn() && hostOf(resource.data.cohortId);
 // Applicant may only withdraw.
 allow update: if isSignedIn()
 && resource.data.applicantUid == myUid()
 && request.resource.data.diff(resource.data).affectedKeys()
 .hasOnly(['status', 'withdrawnAt'])
 && request.resource.data.status == 'withdrawn';
 allow delete: if isAdmin()
 || (isSignedIn() && resource.data.applicantUid == myUid());
 }

 // work_records, "verified work experience", NOT a badge.
 // Issued by the hosting company; we facilitated it but did not assess it.
 // Immutable once issued, and a member can never write her own.
 match /work_records/{id} {
 allow read: if isSignedIn();
 allow create: if isAdmin()
 || (isSignedIn()
 && request.resource.data.isBadge == false
 && request.resource.data.verifiedBySMT == false
 && request.resource.data.memberUid != myUid()
 && isVerified());
 allow update, delete: if isAdmin();
 }

 // certificate_verifications, PUBLICLY READABLE, deliberately.
 // A recruiter with no account must be able to check a certificate, or
 // verification is useless and certificates are decoration again. These
 // documents contain only what is already printed on the certificate:
 // name, project, role, dates, badges. No email, no uid, no contact
 // details, you cannot walk backwards from a certificate to a member's
 // private data.
 match /certificate_verifications/{certId} {
 allow read: if true;
 // Written only by the owner of the project the certificate came from,
 // or an admin. Immutable afterwards; revocation is an admin action.
 allow create: if isAdmin()
 || (isSignedIn()
 && request.resource.data.projectId is string
 && ownsProject(request.resource.data.projectId));
 allow update, delete: if isAdmin();
 }

 // activation_claims, a company states it has paid and supplies a payment
 // reference. Creating a claim grants NOTHING: access is switched on only
 // by a reviewer in the activation queue, after checking the payment
 // actually landed. A redirect URL is not proof of payment.
 match /activation_claims/{id} {
 allow read: if isSignedIn() && (ownsExisting('companyId') || isReviewer());
 // Retired (Talent Access activation).
 allow create: if false;
 allow update: if isReviewer();
 allow delete: if isAdmin();
 }

 match /stripe_events/{id} { allow read, write: if false; }

 // sponsorships, a company funds stipends for one team.
 match /sponsorships/{id} {
 allow read: if isSignedIn();
 // Retired company sponsorships: only staff record them now.
 allow create: if isReviewer();
 allow update: if isReviewer();
 allow delete: if isAdmin();
 }

 // outreach, company DM allowance. Members are never metered.
 match /outreach/{docId} {
 allow read: if isSignedIn() && ownsExisting('recruiterId');
 // Retired (old recruiter outreach counter).
 allow create: if false;
 allow update: if isSignedIn() && ownsExisting('recruiterId') && ownsNew('recruiterId')
 && request.resource.data.count == resource.data.count + 1;
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // posts + replies (Community)
 // ---------------------------------------------------------------
 // Lets account deletion find the member's own replies in one query
 // (utils/deleteUserContent.js). Only her own replies are readable this way.
 match /{path=**}/replies/{replyId} {
 allow read: if isSignedIn() && resource.data.get('authorId', '') == myUid();
 }

 match /posts/{postId} {
 // Like / unlike (SinglePost.jsx) and removing your likes or reposts when
 // you delete your account (deleteUserContent.js): only your own uid goes in
 // or out of the list, and its count moves by exactly one with it.
 function onlyMeAdded(arr) {
 return !(myUid() in resource.data.get(arr, []))
 && request.resource.data.get(arr, []) == resource.data.get(arr, []).concat([myUid()]);
 }
 function onlyMeRemoved(arr) {
 return myUid() in resource.data.get(arr, [])
 && request.resource.data.get(arr, []) == resource.data.get(arr, []).removeAll([myUid()]);
 }
 function countMoved(counter, delta) {
 return request.resource.data.get(counter, 0) == resource.data.get(counter, 0) + delta;
 }
 function myToggle(arr, counter) {
 return request.resource.data.diff(resource.data).affectedKeys().hasOnly([arr, counter, 'updatedAt'])
 && (!touched('updatedAt') || request.resource.data.updatedAt == request.time)
 && ((onlyMeAdded(arr) && countMoved(counter, 1))
 || (onlyMeRemoved(arr) && countMoved(counter, -1)));
 }
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.authorId == myUid() && isVerified();
 // The author edits her own post's title and text (SinglePost.jsx savePostEdit).
 allow update: if isSignedIn() && resource.data.authorId == myUid()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'isEdited', 'updatedAt'])
 && request.resource.data.get('content', '') is string
 && request.resource.data.get('title', '') is string
 && request.resource.data.get('isEdited', true) == true
 && (!touched('updatedAt') || request.resource.data.updatedAt == request.time);
 // Anyone signed in: her own like, or taking her own repost back.
 allow update: if isSignedIn() && myToggle('likes', 'likeCount');
 allow update: if isSignedIn()
 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reposts', 'repostCount'])
 && onlyMeRemoved('reposts') && countMoved('repostCount', -1);
 // Staff moderate (pin, hide, fix) anything.
 allow update: if isReviewer();
 allow delete: if isSignedIn() && (resource.data.authorId == myUid() || isAdmin());
 match /replies/{replyId} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.authorId == myUid() && isVerified();
 allow update, delete: if isSignedIn()
 && (resource.data.authorId == myUid() || isAdmin());
 }
 }

 // ---------------------------------------------------------------
 // conversations + messages (participants only)
 // ---------------------------------------------------------------
 match /conversations/{convId} {
 allow read: if isSignedIn() && (resource == null || myUid() in resource.data.participants);
 // Free companies can start up to 5 new conversations a month (UTC). The
 // month's quota record must list the other person, written in the same batch.
 allow create: if isSignedIn() && myUid() in request.resource.data.participants
 && (!limitedCompany()
 || isStaffUid(otherParticipant(request.resource.data.participants))
 || (getAfter(/databases/$(database)/documents/message_quota/$(myUid() + '_' + monthKey())).data.contacts.hasAny([otherParticipant(request.resource.data.participants)])
 && getAfter(/databases/$(database)/documents/message_quota/$(myUid() + '_' + monthKey())).data.contacts.size() <= 5))
 // Confirmed email needed, except to message She Model Tech staff (help).
 && (isVerified() || isStaffUid(otherParticipant(request.resource.data.participants)));
 allow update: if isSignedIn() && myUid() in resource.data.participants
 // Nobody can change who is in a conversation.
 && request.resource.data.participants == resource.data.participants;
 allow delete: if isAdmin();
 match /messages/{msgId} {
 allow read: if isSignedIn()
 && myUid() in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
 allow create: if isSignedIn()
 && myUid() in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
 // Confirmed email needed, except when writing to She Model Tech staff.
 && (isVerified() || isStaffUid(otherParticipant(get(/databases/$(database)/documents/conversations/$(convId)).data.participants)));
 allow update: if false;
 allow delete: if isAdmin();
 }
 }

 // ---------------------------------------------------------------
 // wall_stats: views, clicks, reposts and emoji reactions on Proof Wall cards
 // (utils/wallStats.js). key = a_<post> | p_<project> | t_<member>.
 // Counters only ever go up by one; each person changes only her own reaction.
 // ---------------------------------------------------------------
 match /wall_stats/{key} {
 function onlyMine(field) {
 return request.resource.data.get(field, {}).keys().hasOnly([myUid()]);
 }
 function myKeyOnly(field) {
 return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([myUid()]);
 }
 function upByOne(field) {
 return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
 }
 allow read: if isSignedIn();
 allow create: if isSignedIn()
 && key.matches('^[apt]_[A-Za-z0-9_-]{1,200}$')
 && request.resource.data.keys().hasOnly(['views', 'clicks', 'repostCount', 'reactions', 'reactionNames', 'reactionPhotos', 'reactionNotified'])
 && request.resource.data.get('views', 0) in [0, 1]
 && request.resource.data.get('clicks', 0) in [0, 1]
 && request.resource.data.get('repostCount', 0) in [0, 1]
 && onlyMine('reactions') && onlyMine('reactionNames') && onlyMine('reactionPhotos') && onlyMine('reactionNotified');
 allow update: if isSignedIn() && changed(['views']) && upByOne('views');
 allow update: if isSignedIn() && changed(['clicks']) && upByOne('clicks');
 allow update: if isSignedIn() && changed(['repostCount']) && upByOne('repostCount');
 allow update: if isSignedIn()
 && changed(['reactions', 'reactionNames', 'reactionPhotos'])
 && myKeyOnly('reactions') && myKeyOnly('reactionNames') && myKeyOnly('reactionPhotos');
 allow update: if isSignedIn()
 && changed(['reactionNotified'])
 && myKeyOnly('reactionNotified')
 && request.resource.data.reactionNotified[myUid()] == true;
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // activity (Proof Wall)
 // ---------------------------------------------------------------
 match /activity/{id} {
 allow read: if isSignedIn();
 allow create: if isReviewer()
 || (isSignedIn()
 && request.resource.data.isDummy == false
 && request.resource.data.type in ['update', 'badge', 'ship', 'lead', 'milestone']
 && isVerified());
 // Love (activityFeed.js toggleCelebrate): only your own uid goes in or out
 // of celebratedBy, the count moves by one with it, and only your own entry
 // in the names and photos maps changes.
 allow update: if isSignedIn()
 && changed(['celebratedBy', 'celebrateCount', 'celebratedByNames', 'celebratedByPhotos'])
 && request.resource.data.get('celebratedByNames', {}).diff(resource.data.get('celebratedByNames', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.get('celebratedByPhotos', {}).diff(resource.data.get('celebratedByPhotos', {})).affectedKeys().hasOnly([myUid()])
 && ((!(myUid() in resource.data.get('celebratedBy', []))
 && request.resource.data.get('celebratedBy', []) == resource.data.get('celebratedBy', []).concat([myUid()])
 && request.resource.data.get('celebrateCount', 0) == resource.data.get('celebrateCount', 0) + 1)
 || (myUid() in resource.data.get('celebratedBy', [])
 && request.resource.data.get('celebratedBy', []) == resource.data.get('celebratedBy', []).removeAll([myUid()])
 && request.resource.data.get('celebrateCount', 0) == resource.data.get('celebrateCount', 0) - 1));
 // Reactions on updates: each person changes only her own reaction.
 allow update: if isSignedIn() && resource.data.get('type', '') == 'update'
 && changed(['reactions', 'reactionNames', 'reactionPhotos'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.get('reactionNames', {}).diff(resource.data.get('reactionNames', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.get('reactionPhotos', {}).diff(resource.data.get('reactionPhotos', {})).affectedKeys().hasOnly([myUid()]);
 // "Already told the author about my reaction" mark: each person sets only her own.
 allow update: if isSignedIn() && resource.data.get('type', '') == 'update'
 && changed(['reactionNotified'])
 && request.resource.data.get('reactionNotified', {}).diff(resource.data.get('reactionNotified', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.reactionNotified[myUid()] == true;
 // Comment and repost counts move by one at a time.
 allow update: if isSignedIn() && resource.data.get('type', '') == 'update'
 && changed(['commentCount', 'repostCount'])
 && request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0) <= 1
 && request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0) >= -1
 && request.resource.data.get('repostCount', 0) - resource.data.get('repostCount', 0) <= 1
 && request.resource.data.get('repostCount', 0) - resource.data.get('repostCount', 0) >= 0;
 // Comments on updates.
 match /comments/{cid} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.uid == myUid()
 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
 && (request.resource.data.get('parentId', null) == null || request.resource.data.parentId is string)
 && isVerified();
 // Reactions on a comment: each person changes only her own.
 allow update: if isSignedIn()
 && changed(['reactions', 'reactionNames', 'reactionPhotos'])
 && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.get('reactionNames', {}).diff(resource.data.get('reactionNames', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.get('reactionPhotos', {}).diff(resource.data.get('reactionPhotos', {})).affectedKeys().hasOnly([myUid()]);
 // The author edits her own comment or reply: only the text, tags and edit time.
 allow update: if isSignedIn() && resource.data.uid == myUid()
 && changed(['text', 'mentions', 'editedAt'])
 && request.resource.data.text is string
 && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
 && request.resource.data.get('mentions', []) is list
 && request.resource.data.editedAt == request.time;
 // "Already told the author about my reaction" mark on a comment.
 allow update: if isSignedIn()
 && changed(['reactionNotified'])
 && request.resource.data.get('reactionNotified', {}).diff(resource.data.get('reactionNotified', {})).affectedKeys().hasOnly([myUid()])
 && request.resource.data.reactionNotified[myUid()] == true;
 // Reply count moves by one at a time.
 allow update: if isSignedIn() && changed(['replyCount'])
 && request.resource.data.get('replyCount', 0) - resource.data.get('replyCount', 0) <= 1
 && request.resource.data.get('replyCount', 0) - resource.data.get('replyCount', 0) >= -1;
 allow delete: if isSignedIn() && (resource.data.uid == myUid() || isAdmin());
 }
 allow update: if isSignedIn() && resource.data.actorId == myUid()
 && changed(['text', 'projectTitle']);
 allow update: if isAdmin();
 allow delete: if isAdmin() || (isSignedIn() && resource.data.actorId == myUid());
 }

    // hub_posts / applications: the job board was removed. A free board on a
    // platform with no traffic teaches companies we are a worse LinkedIn and
    // lets them extract contacts without engaging. Companies now sponsor a
    // cohort or host a paid project. No rule = deny.

 // ---------------------------------------------------------------
 // notifications (recipient only)
 // ---------------------------------------------------------------
 match /notifications/{nId} {
 allow read: if isSignedIn()
 && (resource.data.get('userId', '') == myUid()
 || resource.data.get('recipientId', '') == myUid());
 // Free companies can't use notifications to reach members (only staff).
 allow create: if isSignedIn()
 // One recipient per notice (userId and recipientId, when both set, match).
 && request.resource.data.get('recipientId', request.resource.data.get('userId', '')) == request.resource.data.get('userId', request.resource.data.get('recipientId', ''))
 && (!limitedCompany() || request.resource.data.get('userId', '') == myUid()
 || isStaffUid(request.resource.data.get('userId', request.resource.data.get('recipientId', '')))
 // A new-message notice to someone she already has a conversation with.
 || (request.resource.data.get('type', '') == 'message'
 && exists(/databases/$(database)/documents/conversations/$(request.resource.data.get('convId', '-')))
 && myUid() in get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.participants
 && request.resource.data.get('userId', '') in get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.participants))
 // Notices to other people need a confirmed email (notices to yourself and
 // to She Model Tech staff don't).
 && (request.resource.data.get('userId', request.resource.data.get('recipientId', '')) == myUid()
 || isVerified()
 || isStaffUid(request.resource.data.get('userId', request.resource.data.get('recipientId', ''))));
 allow update, delete: if isSignedIn()
 && (resource.data.get('userId', '') == myUid()
 || resource.data.get('recipientId', '') == myUid()
 || isAdmin());
 }

 // Follow records: you follow as yourself. Either side can remove one (account
 // deletion removes both directions, deleteUserContent.js); staff can too.
 match /follows/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.followerId == myUid()
 && request.resource.data.get('followingId', '') != myUid();
 allow update: if isSignedIn() && resource.data.followerId == myUid()
 && request.resource.data.followerId == myUid()
 && request.resource.data.get('followingId', '') == resource.data.get('followingId', '');
 allow delete: if isSignedIn() && (resource.data.get('followerId', '') == myUid()
 || resource.data.get('followingId', '') == myUid() || isAdmin());
 allow create, update: if isAdmin();
 }

 match /project_completion_requests/{id} {
 allow read: if isSignedIn();
 // Staff, or a project's own lead about her project, as herself.
 allow create: if isReviewer()
 || (isSignedIn() && ownsNew('submitterId')
 && request.resource.data.get('projectId', null) is string
 && ownsProject(request.resource.data.projectId)
 && isVerified());
 allow update: if isReviewer() || (isSignedIn() && ownsExisting('submitterId'));
 allow delete: if isAdmin();
 }

 // ---------------------------------------------------------------
 // Companies / groups / events, owner-or-admin, not open season.
 // ---------------------------------------------------------------
 match /companies/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('ownerId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('ownerId') || isAdmin());
 }
 match /company_members/{id} {
 allow read: if isSignedIn();
 // Join only as yourself, as a plain member waiting for approval (a
 // self-made 'admin'/'owner'/'active' row is what ownership checks read).
 allow create: if isAdmin()
 || (isSignedIn() && ownsNew('userId')
 && request.resource.data.get('role', 'member') == 'member'
 && request.resource.data.get('status', 'pending') == 'pending'
 && isVerified());
 allow update, delete: if isSignedIn() && (ownsExisting('userId') || isAdmin());
 }
 match /groups/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('ownerId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('ownerId') || isAdmin());
 }
 match /group_members/{id} {
 allow read: if isSignedIn();
 // Join only as yourself, as a plain member waiting for approval (a
 // self-made 'admin'/'owner'/'active' row is what ownership checks read).
 allow create: if isAdmin()
 || (isSignedIn() && ownsNew('userId')
 && request.resource.data.get('role', 'member') == 'member'
 && request.resource.data.get('status', 'pending') == 'pending'
 && isVerified());
 allow update, delete: if isSignedIn() && (ownsExisting('userId') || isAdmin());
 }
 match /group_posts/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('authorId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('authorId') || isAdmin());
 }
 match /event_groups/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('ownerId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('ownerId') || isAdmin());
 }
 match /event_group_members/{id} {
 allow read: if isSignedIn();
 // Join only as yourself, as a plain member waiting for approval (a
 // self-made 'admin'/'owner'/'active' row is what ownership checks read).
 allow create: if isAdmin()
 || (isSignedIn() && ownsNew('userId')
 && request.resource.data.get('role', 'member') == 'member'
 && request.resource.data.get('status', 'pending') == 'pending'
 && isVerified());
 allow update, delete: if isSignedIn() && (ownsExisting('userId') || isAdmin());
 }
 match /event_group_posts/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('authorId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('authorId') || isAdmin());
 }
 match /tech_events/{id} {
 allow read: if isSignedIn();
 allow create, update: if isReviewer();
 allow delete: if isAdmin();
 }
 match /post_replies/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('authorId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('authorId') || isAdmin());
 }

 match /ai_career_content/{id} {
 allow read: if isSignedIn();
 allow write: if isAdmin();
 }

 // Community Foundations lessons
 match /foundationsContributions/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && request.resource.data.authorId == myUid() && isVerified();
 // Author or admin; anyone else only adds (or changes) one 1-5 star rating.
 allow update: if isSignedIn() && (
 resource.data.authorId == myUid() || isAdmin()
 || (changed(['ratingSum', 'ratingCount'])
 && (request.resource.data.get('ratingCount', 0) - resource.data.get('ratingCount', 0)) in [0, 1]
 && request.resource.data.get('ratingSum', 0) - resource.data.get('ratingSum', 0) >= -4
 && request.resource.data.get('ratingSum', 0) - resource.data.get('ratingSum', 0) <= 5)
 );
 allow delete: if isAdmin();
 match /ratings/{uid} {
 allow read: if isSignedIn();
 allow create, update: if isSignedIn() && uid == myUid() && isVerified();
 allow delete: if isSignedIn() && uid == myUid();
 }
 }

 // Private to the owner.
 match /career_analyses/{id} {
 allow read, update, delete: if isSignedIn() && ownsExisting('userId');
 allow create: if isSignedIn() && ownsNew('userId');
 }
 match /client_projects/{id} {
 allow read: if isSignedIn();
 allow create: if isSignedIn() && ownsNew('submitterId') && isVerified();
 allow update, delete: if isSignedIn() && (ownsExisting('submitterId') || isAdmin());
 }

 match /adminUsers/{id} { allow read, write: if isAdmin(); }
 match /admin_notifications/{id} {
 allow read, update: if isReviewer();
 allow create: if isSignedIn() && isVerified();
 allow delete: if isAdmin();
 }
 match /email_logs/{id} { allow read: if isAdmin(); allow write: if false; }

 // Anything not matched above is DENIED by default.
 }
}
