{
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "devCommand": "npm start",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(sw\\.js|firebase-messaging-sw\\.js|manifest\\.json)",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/(index\\.html)?",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/cron/backup",
      "dest": "/api/cron/project-reminders?task=backup"
    },
    {
      "src": "/api/notifications/([^/]+)",
      "dest": "/api/notifications/[type]?type=$1"
    },
    {
      "src": "/__/(.*)",
      "dest": "https://she-model-tech.firebaseapp.com/__/$1"
    },
    {
      "src": "/s/(e|p)/([^/]+)",
      "dest": "/api/public-request?share=$1&id=$2"
    },
    {
      "src": "/update/([^/]+)",
      "dest": "/api/public-request?preview=u&id=$1"
    },
    {
      "src": "/project/([^/]+)",
      "dest": "/api/public-request?preview=p&id=$1"
    },
    {
      "src": "/sitemap-content.xml",
      "dest": "/api/public-request?sitemap=1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/email/send-weekly-digest",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/api/email/send-weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/email/send-daily-digest",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/project-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 3 * * *"
    }
  ]
}
